+  // Configure capture group membership before EnableVideoInput.
+  // bmdDeckLinkConfigCaptureGroup persists on the IDeckLink object until
+  // system reboot (per BMD SDK manual), so on every start we either set
+  // it to the requested group ID or explicitly clear it to -1 — that way
+  // a stale value from a previous run never leaks into a fresh session.
+  gboolean use_capture_group = FALSE;
+  if (self->input->config && self->input->attributes) {
