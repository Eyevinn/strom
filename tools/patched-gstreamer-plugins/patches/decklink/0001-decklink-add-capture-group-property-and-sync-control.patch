+
+    bool should_call_start = true;
+    if (self->capture_group >= 0) {
+      std::lock_guard<std::mutex> lock (g_capture_group_state_mutex);
+      CaptureGroupState &state = g_capture_group_state[self->capture_group];
+      if (state.refcount == 0) {
+        state.leader_input = self->input->input;
+        GST_DEBUG_OBJECT (self,
+            "Capture group %d leader: calling StartStreams",
+            self->capture_group);
+      } else {
+        should_call_start = false;
+        GST_DEBUG_OBJECT (self,
