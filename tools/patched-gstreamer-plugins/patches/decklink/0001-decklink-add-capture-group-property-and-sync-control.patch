+// Cross-IDeckLink coordination for synchronized capture groups.
+//
+// BMD SDK manual specifies that a synchronized capture group is started by
+// calling StartStreams() on any one input device in the group, and stopped
+// by calling StopStreams() on any one input. The plugin's element model
+// otherwise calls Start/Stop once per element, which is the wrong semantic
+// for synced groups: every member calling StartStreams works (subsequent
+// calls are quietly accepted), but every member calling StopStreams hangs
+// the BMD driver on the second call.
+//
+// We refcount membership per group so exactly one StartStreams and one
+// StopStreams reach the driver, on the same IDeckLinkInput instance — the
+// "leader" — that called StartStreams. BMD's StopStreams on a synced input
+// blocks for ~12s (driver-internal timeout, see Blackmagic forum thread
+// 190441; reproducible in the SynchronizedCapture SDK example). We accept
+// the wait to keep the documented teardown order (StopStreams ->
+// DisableVideoInput) intact, otherwise subsequent pipeline starts fail
+// with caps not-negotiated.
+struct CaptureGroupState {
+  int refcount = 0;
+  IDeckLinkInput *leader_input = nullptr;
+};
+static std::mutex g_capture_group_state_mutex;
+static std::map<int, CaptureGroupState> g_capture_group_state;
+
 #define DEFAULT_MODE (GST_DECKLINK_MODE_AUTO)
 #define DEFAULT_CONNECTION (GST_DECKLINK_CONNECTION_AUTO)
 #define DEFAULT_BUFFER_SIZE (5)
 #define DEFAULT_OUTPUT_STREAM_TIME (FALSE)
+#define DEFAULT_CAPTURE_GROUP (-1)
