+    if (should_call_start) {
+      res = self->input->input->StartStreams ();
+      if (res != S_OK) {
+        GST_ELEMENT_ERROR (self, STREAM, FAILED,
+            (NULL), ("Failed to start streams: 0x%08lx", (unsigned long) res));
+        return;
+      }
     }
   } else {
     GST_DEBUG_OBJECT (self, "Not starting streams yet");
