     // Custom methods:
     void MakeBrowser(int)
+    {
+      // Every browser created with a null request context shares the global
+      // one, and with it cookies, local storage and the HTTP cache with every
+      // other cefsrc in the process. An isolated context keeps them apart.
+      // Popups opened by the page inherit it.
+      if (!src->isolated_context) {
+        CreateBrowserIn(nullptr);
+        return;
+      }
+
+      CefRequestContextSettings context_settings;
+      if (src->context_cache_path && *src->context_cache_path) {
+        // Must be a direct child of the root cache path
+        // (GST_CEF_CACHE_LOCATION), or CEF refuses to create the profile.
+        CefString(&context_settings.cache_path).FromASCII(src->context_cache_path);
+        // Chromium's own persist-session-cookies flag reaches only the global
+        // context; an isolated one carries its own setting.
+        context_settings.persist_session_cookies = src->persist_session_cookies;
+      }
+      GST_INFO_OBJECT (src, "Using an isolated request context (%s)",
+          (src->context_cache_path && *src->context_cache_path) ?
+          src->context_cache_path : "in memory");
+
+      // A persisted context initializes asynchronously, and a browser created
+      // in it before then fails. The browser is made once it is ready.
+      CefRequestContext::CreateContext(context_settings,
+          new ContextReadyHandler(this));
+    }
