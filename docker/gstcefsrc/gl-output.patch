diff --git a/gstcefgl.cc b/gstcefgl.cc
new file mode 100644
index 0000000..0b032ea
--- /dev/null
+++ b/gstcefgl.cc
@@ -0,0 +1,644 @@
+#include "gstcefgl.h"
+
+#include <string.h>
+#include <gst/gl/gl.h>
+#include <gst/gl/gstglfuncs.h>
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+
+GST_DEBUG_CATEGORY_STATIC (cef_gl_debug);
+#define GST_CAT_DEFAULT cef_gl_debug
+
+/* DRM fourccs, so drm_fourcc.h is not needed. */
+#define CEF_DRM_FORMAT_ARGB8888 0x34325241 /* AR24: bytes B G R A */
+#define CEF_DRM_FORMAT_ABGR8888 0x34324241 /* AB24: bytes R G B A */
+#define CEF_DRM_FORMAT_MOD_INVALID 0x00ffffffffffffffULL
+
+struct _GstCefGl {
+  GstElement *element;          /* not reffed: owns this */
+  GRecMutex lock;  /* recursive: ensure_element_data calls back into set_context */
+
+  GstGLDisplay *display;
+  GstGLContext *other_context;  /* the application's */
+  GstGLContext *context;        /* the one the flow's GL elements use */
+  GstGLContext *worker;         /* ours, shares with context */
+
+  gboolean ready;               /* worker can import dma-bufs */
+  gboolean gl_output;           /* GL memory negotiated */
+  GstVideoInfo info;
+  GstBufferPool *pool;
+
+  /* worker-thread state */
+  GLuint fbo_read, fbo_draw;
+  PFNEGLCREATEIMAGEKHRPROC create_image;
+  PFNEGLDESTROYIMAGEKHRPROC destroy_image;
+  PFNGLEGLIMAGETARGETTEXTURE2DOESPROC image_target;
+
+  /* statistics, logged at DEBUG every 10 s */
+  guint64 frames, failures;
+  gdouble ms_sum, ms_max;
+  gint64 stat_start;
+  gboolean announced;
+  guint64 test_break_after;     /* GST_CEF_GL_TEST_BREAK_IMPORT: fail the Nth import */
+  guint64 imports;
+  guint64 uploads;
+  guint mismatches;             /* GPU frames in a row this code cannot take */
+  GstBufferPool *sys_pool;      /* system-memory output buffers */
+};
+
+GstCefGl *
+gst_cef_gl_new (GstElement * element)
+{
+  static gsize init = 0;
+  if (g_once_init_enter (&init)) {
+    GST_DEBUG_CATEGORY_INIT (cef_gl_debug, "cefgl", 0, "cefsrc GPU output");
+    g_once_init_leave (&init, 1);
+  }
+  GstCefGl *gl = g_new0 (GstCefGl, 1);
+  gl->element = element;
+  g_rec_mutex_init (&gl->lock);
+  return gl;
+}
+
+void
+gst_cef_gl_free (GstCefGl * gl)
+{
+  if (!gl)
+    return;
+  gst_cef_gl_reset (gl);
+  gst_clear_object (&gl->display);
+  gst_clear_object (&gl->other_context);
+  g_rec_mutex_clear (&gl->lock);
+  g_free (gl);
+}
+
+void
+gst_cef_gl_set_context (GstCefGl * gl, GstContext * context)
+{
+  g_rec_mutex_lock (&gl->lock);
+  gst_gl_handle_set_context (gl->element, context, &gl->display,
+      &gl->other_context);
+  g_rec_mutex_unlock (&gl->lock);
+}
+
+gboolean
+gst_cef_gl_handle_query (GstCefGl * gl, GstQuery * query)
+{
+  gboolean ret;
+  g_rec_mutex_lock (&gl->lock);
+  ret = gst_gl_handle_context_query (gl->element, query, gl->display,
+      gl->context, gl->other_context);
+  g_rec_mutex_unlock (&gl->lock);
+  return ret;
+}
+
+/* --- worker thread --- */
+
+static gboolean
+has_extension (const char *list, const char *name)
+{
+  size_t n = strlen (name);
+  for (const char *p = list; p && (p = strstr (p, name)); p += n)
+    if ((p == list || p[-1] == ' ') && (p[n] == ' ' || p[n] == '\0'))
+      return TRUE;
+  return FALSE;
+}
+
+static void
+worker_init (GstGLContext * ctx, gpointer data)
+{
+  GstCefGl *gl = (GstCefGl *) data;
+  const GstGLFuncs *f = ctx->gl_vtable;
+
+  gl->ready = FALSE;
+  if (gst_gl_context_get_gl_platform (ctx) != GST_GL_PLATFORM_EGL) {
+    GST_INFO_OBJECT (gl->element, "GL context is not EGL: no dma-buf import");
+    return;
+  }
+  EGLDisplay dpy = eglGetCurrentDisplay ();
+  const char *exts = dpy != EGL_NO_DISPLAY ? eglQueryString (dpy, EGL_EXTENSIONS) : NULL;
+  if (!has_extension (exts, "EGL_EXT_image_dma_buf_import")
+      || !has_extension (exts, "EGL_EXT_image_dma_buf_import_modifiers")) {
+    GST_INFO_OBJECT (gl->element,
+        "EGL display has no dma-buf import with modifiers");
+    return;
+  }
+  gl->create_image = (PFNEGLCREATEIMAGEKHRPROC) eglGetProcAddress ("eglCreateImageKHR");
+  gl->destroy_image = (PFNEGLDESTROYIMAGEKHRPROC) eglGetProcAddress ("eglDestroyImageKHR");
+  gl->image_target = (PFNGLEGLIMAGETARGETTEXTURE2DOESPROC)
+      gst_gl_context_get_proc_address (ctx, "glEGLImageTargetTexture2DOES");
+  if (!gl->create_image || !gl->destroy_image || !gl->image_target
+      || !f->BlitFramebuffer || !f->GenFramebuffers) {
+    GST_INFO_OBJECT (gl->element,
+        "GL context lacks EGLImage or framebuffer blit support");
+    return;
+  }
+  f->GenFramebuffers (1, &gl->fbo_read);
+  f->GenFramebuffers (1, &gl->fbo_draw);
+  gl->ready = TRUE;
+  GST_INFO_OBJECT (gl->element, "GPU output ready: %s on %s",
+      (const char *) f->GetString (GL_VERSION),
+      (const char *) f->GetString (GL_RENDERER));
+}
+
+static void
+worker_deinit (GstGLContext * ctx, gpointer data)
+{
+  GstCefGl *gl = (GstCefGl *) data;
+  const GstGLFuncs *f = ctx->gl_vtable;
+  if (gl->fbo_read)
+    f->DeleteFramebuffers (1, &gl->fbo_read);
+  if (gl->fbo_draw)
+    f->DeleteFramebuffers (1, &gl->fbo_draw);
+  gl->fbo_read = gl->fbo_draw = 0;
+}
+
+static GLuint
+buffer_texture (GstBuffer * buf)
+{
+  GstMemory *mem = gst_buffer_peek_memory (buf, 0);
+  if (!mem || !gst_is_gl_memory (mem))
+    return 0;
+  return gst_gl_memory_get_texture_id ((GstGLMemory *) mem);
+}
+
+/* The texture was written by GL directly: a CPU map must download it. */
+static void
+mark_written (GstBuffer * buf)
+{
+  GstMemory *mem = gst_buffer_peek_memory (buf, 0);
+  GST_MINI_OBJECT_FLAG_SET (mem, GST_GL_BASE_MEMORY_TRANSFER_NEED_DOWNLOAD);
+  GST_MINI_OBJECT_FLAG_UNSET (mem, GST_GL_BASE_MEMORY_TRANSFER_NEED_UPLOAD);
+}
+
+struct ClearJob { GstCefGl *gl; GLuint tex; };
+
+static void
+worker_clear (GstGLContext * ctx, gpointer data)
+{
+  ClearJob *job = (ClearJob *) data;
+  const GstGLFuncs *f = ctx->gl_vtable;
+  f->BindFramebuffer (GL_FRAMEBUFFER, job->gl->fbo_draw);
+  f->FramebufferTexture2D (GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, job->tex, 0);
+  f->ClearColor (0, 0, 0, 0);
+  f->Clear (GL_COLOR_BUFFER_BIT);
+  f->BindFramebuffer (GL_FRAMEBUFFER, 0);
+  f->Finish ();
+}
+
+struct ImportJob {
+  GstCefGl *gl;
+  const CefAcceleratedPaintInfo *info;
+  GLuint dst_tex;
+  gboolean ok, broken;
+};
+
+static void
+worker_import (GstGLContext * ctx, gpointer data)
+{
+  ImportJob *job = (ImportJob *) data;
+  GstCefGl *gl = job->gl;
+  const CefAcceleratedPaintInfo &info = *job->info;
+  const GstGLFuncs *f = ctx->gl_vtable;
+  int w = GST_VIDEO_INFO_WIDTH (&gl->info), h = GST_VIDEO_INFO_HEIGHT (&gl->info);
+
+  /* The output is BGRA in memory order. Importing the buffer under the
+   * fourcc whose channels are the bytes in memory order makes the copy keep
+   * them as they are: Chromium's BGRA is imported as AB24 (R G B A), so the
+   * texture's "red" holds blue and its bytes match what OnPaint delivers. */
+  EGLint fourcc = info.format == CEF_COLOR_TYPE_BGRA_8888 ?
+      CEF_DRM_FORMAT_ABGR8888 : CEF_DRM_FORMAT_ARGB8888;
+  EGLint a[24];
+  int i = 0;
+  a[i++] = EGL_WIDTH; a[i++] = w;
+  a[i++] = EGL_HEIGHT; a[i++] = h;
+  a[i++] = EGL_LINUX_DRM_FOURCC_EXT; a[i++] = fourcc;
+  a[i++] = EGL_DMA_BUF_PLANE0_FD_EXT; a[i++] = info.planes[0].fd;
+  a[i++] = EGL_DMA_BUF_PLANE0_OFFSET_EXT; a[i++] = (EGLint) info.planes[0].offset;
+  a[i++] = EGL_DMA_BUF_PLANE0_PITCH_EXT; a[i++] = (EGLint) info.planes[0].stride;
+  if (info.modifier != CEF_DRM_FORMAT_MOD_INVALID) {
+    a[i++] = EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT; a[i++] = (EGLint) (info.modifier & 0xffffffff);
+    a[i++] = EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT; a[i++] = (EGLint) (info.modifier >> 32);
+  }
+  a[i++] = EGL_NONE;
+
+  EGLImageKHR img = gl->create_image (eglGetCurrentDisplay (), EGL_NO_CONTEXT,
+      EGL_LINUX_DMA_BUF_EXT, nullptr, a);
+  if (img == EGL_NO_IMAGE_KHR) {
+    GST_WARNING_OBJECT (gl->element, "eglCreateImage of Chromium's frame failed: 0x%x "
+        "(fourcc 0x%x modifier 0x%" G_GINT64_MODIFIER "x planes %d)", eglGetError (),
+        fourcc, (guint64) info.modifier, info.plane_count);
+    job->broken = TRUE;
+    return;
+  }
+
+  GLuint tex;
+  f->GenTextures (1, &tex);
+  f->BindTexture (GL_TEXTURE_2D, tex);
+  gl->image_target (GL_TEXTURE_2D, img);
+  f->BindTexture (GL_TEXTURE_2D, 0);
+  f->BindFramebuffer (GL_READ_FRAMEBUFFER, gl->fbo_read);
+  f->FramebufferTexture2D (GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+  GLenum st = f->CheckFramebufferStatus (GL_READ_FRAMEBUFFER);
+  if (st != GL_FRAMEBUFFER_COMPLETE) {
+    GST_WARNING_OBJECT (gl->element, "Chromium's frame cannot be read (framebuffer 0x%x)", st);
+    job->broken = TRUE;
+  } else {
+    f->BindFramebuffer (GL_DRAW_FRAMEBUFFER, gl->fbo_draw);
+    f->FramebufferTexture2D (GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, job->dst_tex, 0);
+    f->BlitFramebuffer (0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    f->BindFramebuffer (GL_DRAW_FRAMEBUFFER, 0);
+    job->ok = TRUE;
+  }
+  f->BindFramebuffer (GL_READ_FRAMEBUFFER, 0);
+  /* Chromium reuses the buffer once the callback returns, so the copy must
+   * be done before it does. This also means downstream needs no sync. */
+  f->Finish ();
+  f->DeleteTextures (1, &tex);
+  gl->destroy_image (eglGetCurrentDisplay (), img);
+  GLenum err = f->GetError ();
+  if (err != GL_NO_ERROR) {
+    GST_WARNING_OBJECT (gl->element, "GL error 0x%x copying Chromium's frame", err);
+    job->ok = FALSE;
+  }
+}
+
+struct UploadJob { GstCefGl *gl; GLuint tex; const void *data; int w, h; };
+
+static void
+worker_upload (GstGLContext * ctx, gpointer data)
+{
+  UploadJob *job = (UploadJob *) data;
+  const GstGLFuncs *f = ctx->gl_vtable;
+  /* BGRA bytes into the RGBA8 texture as they are: GL memory in format
+   * BGRA is stored that way. */
+  f->BindTexture (GL_TEXTURE_2D, job->tex);
+  f->PixelStorei (GL_UNPACK_ALIGNMENT, 4);
+  f->TexSubImage2D (GL_TEXTURE_2D, 0, 0, 0, job->w, job->h, GL_RGBA, GL_UNSIGNED_BYTE, job->data);
+  f->BindTexture (GL_TEXTURE_2D, 0);
+  f->Finish ();
+}
+
+/* --- setup --- */
+
+static void
+release_worker_locked (GstCefGl * gl)
+{
+  if (gl->sys_pool) {
+    gst_buffer_pool_set_active (gl->sys_pool, FALSE);
+    gst_clear_object (&gl->sys_pool);
+  }
+  if (gl->pool) {
+    gst_buffer_pool_set_active (gl->pool, FALSE);
+    gst_clear_object (&gl->pool);
+  }
+  if (gl->worker) {
+    gst_gl_context_thread_add (gl->worker, worker_deinit, gl);
+    gst_clear_object (&gl->worker);
+  }
+  gl->ready = FALSE;
+}
+
+/* A worker context of our own, in the share group of `share`, so the UI
+ * thread never waits for the flow's GL thread, and the flow's GL elements can
+ * use the textures. */
+static gboolean
+make_worker_locked (GstCefGl * gl, GstGLContext * share)
+{
+  GError *error = NULL;
+  release_worker_locked (gl);
+  gl->worker = gst_gl_context_new (gl->display);
+  if (!gst_gl_context_create (gl->worker, share, &error)) {
+    GST_WARNING_OBJECT (gl->element, "Could not create a GL context: %s",
+        error ? error->message : "unknown");
+    g_clear_error (&error);
+    gst_clear_object (&gl->worker);
+    return FALSE;
+  }
+  gst_gl_context_thread_add (gl->worker, worker_init, gl);
+  return gl->ready;
+}
+
+gboolean
+gst_cef_gl_prepare (GstCefGl * gl)
+{
+  GError *error = NULL;
+
+  g_rec_mutex_lock (&gl->lock);
+  release_worker_locked (gl);
+  if (!gst_gl_ensure_element_data (gl->element, &gl->display, &gl->other_context)) {
+    GST_INFO_OBJECT (gl->element, "No GL display: software output");
+    goto out;
+  }
+  if (!gl->context)
+    gst_gl_query_local_gl_context (gl->element, GST_PAD_SRC, &gl->context);
+  if (!gl->context) {
+    GST_OBJECT_LOCK (gl->display);
+    do {
+      gst_clear_object (&gl->context);
+      gl->context = gst_gl_display_get_gl_context_for_thread (gl->display, NULL);
+      if (!gl->context && !gst_gl_display_create_context (gl->display,
+              gl->other_context, &gl->context, &error)) {
+        GST_OBJECT_UNLOCK (gl->display);
+        GST_INFO_OBJECT (gl->element, "No GL context (%s): software output",
+            error ? error->message : "unknown");
+        g_clear_error (&error);
+        goto out;
+      }
+    } while (!gst_gl_display_add_context (gl->display, gl->context));
+    GST_OBJECT_UNLOCK (gl->display);
+  }
+  make_worker_locked (gl, gl->context);
+  GST_INFO_OBJECT (gl->element, "GL context at start: %" GST_PTR_FORMAT ", worker %" GST_PTR_FORMAT,
+      gl->context, gl->worker);
+  gl->imports = gl->uploads = 0;
+  gl->test_break_after = g_ascii_strtoull (g_getenv ("GST_CEF_GL_TEST_BREAK_IMPORT") ?: "0", NULL, 10);
+
+out:
+  gboolean ready = gl->ready;
+  g_rec_mutex_unlock (&gl->lock);
+  return ready;
+}
+
+gboolean
+gst_cef_gl_ready (GstCefGl * gl)
+{
+  g_rec_mutex_lock (&gl->lock);
+  gboolean ready = gl->ready;
+  g_rec_mutex_unlock (&gl->lock);
+  return ready;
+}
+
+gboolean
+gst_cef_gl_output_is_gl (GstCefGl * gl)
+{
+  g_rec_mutex_lock (&gl->lock);
+  gboolean r = gl->gl_output;
+  g_rec_mutex_unlock (&gl->lock);
+  return r;
+}
+
+gboolean
+gst_cef_gl_decide_allocation (GstCefGl * gl, GstQuery * query)
+{
+  GstCaps *caps;
+  gboolean ret = TRUE;
+
+  gst_query_parse_allocation (query, &caps, NULL);
+  if (!caps)
+    return FALSE;
+
+  g_rec_mutex_lock (&gl->lock);
+  gst_video_info_from_caps (&gl->info, caps);
+  gl->gl_output = gst_caps_features_contains (gst_caps_get_features (caps, 0),
+      GST_CAPS_FEATURE_MEMORY_GL_MEMORY);
+
+  if (gl->pool) {
+    gst_buffer_pool_set_active (gl->pool, FALSE);
+    gst_clear_object (&gl->pool);
+  }
+  if (gl->sys_pool) {
+    gst_buffer_pool_set_active (gl->sys_pool, FALSE);
+    gst_clear_object (&gl->sys_pool);
+  }
+  if (gl->ready && !gl->gl_output) {
+    /* Read-back frames go into recycled buffers, not a fresh allocation each. */
+    gl->sys_pool = gst_buffer_pool_new ();
+    GstStructure *sc = gst_buffer_pool_get_config (gl->sys_pool);
+    gst_buffer_pool_config_set_params (sc, caps, GST_VIDEO_INFO_SIZE (&gl->info), 2, 0);
+    if (!gst_buffer_pool_set_config (gl->sys_pool, sc) || !gst_buffer_pool_set_active (gl->sys_pool, TRUE))
+      gst_clear_object (&gl->sys_pool);
+  }
+  gl->mismatches = 0;
+
+  if (gl->gl_output) {
+    /* The frames must be in the share group of the context that uses them,
+     * or a GL element refuses them as from another context. The consumer's
+     * own context is the one its proposed pool allocates in; failing that,
+     * ask downstream for its local context. Contexts are made as elements
+     * start, in no fixed order, so the one picked at start may not be it. */
+    GstGLContext *consumer = NULL;
+    for (guint i = 0; i < gst_query_get_n_allocation_pools (query) && !consumer; i++) {
+      GstBufferPool *proposed = NULL;
+      gst_query_parse_nth_allocation_pool (query, i, &proposed, NULL, NULL, NULL);
+      if (proposed && GST_IS_GL_BUFFER_POOL (proposed) && GST_GL_BUFFER_POOL (proposed)->context)
+        consumer = (GstGLContext *) gst_object_ref (GST_GL_BUFFER_POOL (proposed)->context);
+      if (proposed)
+        gst_object_unref (proposed);
+    }
+    if (!consumer)
+      gst_gl_query_local_gl_context (gl->element, GST_PAD_SRC, &consumer);
+    GST_INFO_OBJECT (gl->element, "Consumer GL context %" GST_PTR_FORMAT ", worker %" GST_PTR_FORMAT,
+        consumer, gl->worker);
+    if (consumer && consumer != gl->context) {
+      /* The pool must allocate in exactly this context object; the worker
+       * only has to be in its share group. */
+      gst_object_replace ((GstObject **) &gl->context, (GstObject *) consumer);
+      if (!(gl->worker && gst_gl_context_can_share (gl->worker, consumer))) {
+        GST_INFO_OBJECT (gl->element, "Sharing GL context with the consumer's %" GST_PTR_FORMAT, consumer);
+        make_worker_locked (gl, consumer);
+      }
+    }
+    gst_clear_object (&consumer);
+
+    if (!gl->ready) {
+      g_rec_mutex_unlock (&gl->lock);
+      GST_ELEMENT_ERROR (gl->element, CORE, NEGOTIATION, (NULL),
+          ("GL memory was negotiated, but cefsrc has no GL context that can import Chromium's frames"));
+      return FALSE;
+    }
+  }
+
+  if (gl->ready) {
+    /* GL output hands these on; system output reads them back. GL elements
+     * take GL memory only from their own GstGLContext, not merely one that
+     * shares with it ("input memory OpenGL context is different"), so with
+     * GL output the memory belongs to the consumer's context. The worker,
+     * in its share group, still does the copying, so the UI thread does not
+     * wait for the flow's GL thread on every frame. */
+    GstCaps *glcaps = gst_caps_copy (caps);
+    gst_caps_set_features_simple (glcaps, gst_caps_features_new (GST_CAPS_FEATURE_MEMORY_GL_MEMORY, NULL));
+    gl->pool = gst_gl_buffer_pool_new (gl->gl_output && gl->context ? gl->context : gl->worker);
+    GstStructure *config = gst_buffer_pool_get_config (gl->pool);
+    gst_buffer_pool_config_set_params (config, glcaps, GST_VIDEO_INFO_SIZE (&gl->info), 2, 0);
+    gst_buffer_pool_config_add_option (config, GST_BUFFER_POOL_OPTION_VIDEO_META);
+    gst_caps_unref (glcaps);
+    if (!gst_buffer_pool_set_config (gl->pool, config)
+        || !gst_buffer_pool_set_active (gl->pool, TRUE)) {
+      GST_ERROR_OBJECT (gl->element, "Could not set up the GL buffer pool");
+      gst_clear_object (&gl->pool);
+      ret = !gl->gl_output;
+    } else if (gl->gl_output && gst_query_get_n_allocation_pools (query) > 0) {
+      gst_query_set_nth_allocation_pool (query, 0, gl->pool, GST_VIDEO_INFO_SIZE (&gl->info), 2, 0);
+    } else if (gl->gl_output) {
+      gst_query_add_allocation_pool (query, gl->pool, GST_VIDEO_INFO_SIZE (&gl->info), 2, 0);
+    }
+  }
+  GST_INFO_OBJECT (gl->element, "Output in %s memory%s", gl->gl_output ? "GL" : "system",
+      gl->ready ? (gl->gl_output ? ", frames copied on the GPU" : ", frames read back from the GPU") : "");
+  g_rec_mutex_unlock (&gl->lock);
+  return ret;
+}
+
+static GstBuffer *
+acquire_locked (GstCefGl * gl)
+{
+  GstBuffer *buf = NULL;
+  if (!gl->pool || gst_buffer_pool_acquire_buffer (gl->pool, &buf, NULL) != GST_FLOW_OK)
+    return NULL;
+  return buf;
+}
+
+GstBuffer *
+gst_cef_gl_blank (GstCefGl * gl)
+{
+  g_rec_mutex_lock (&gl->lock);
+  GstBuffer *buf = acquire_locked (gl);
+  if (buf) {
+    ClearJob job = { gl, buffer_texture (buf) };
+    gst_gl_context_thread_add (gl->worker, worker_clear, &job);
+    mark_written (buf);
+  }
+  g_rec_mutex_unlock (&gl->lock);
+  return buf;
+}
+
+static void
+note_frame_locked (GstCefGl * gl, gdouble ms, gboolean ok)
+{
+  gl->frames++;
+  if (!ok)
+    gl->failures++;
+  gl->ms_sum += ms;
+  if (ms > gl->ms_max)
+    gl->ms_max = ms;
+  gint64 now = g_get_monotonic_time ();
+  if (!gl->stat_start)
+    gl->stat_start = now;
+  if (now - gl->stat_start >= 10 * G_USEC_PER_SEC) {
+    GST_DEBUG_OBJECT (gl->element, "GPU frames: %.1f/s, copy %.2f ms avg %.2f ms max, %" G_GUINT64_FORMAT " failed",
+        gl->frames * 1e6 / (now - gl->stat_start), gl->ms_sum / gl->frames, gl->ms_max, gl->failures);
+    gl->frames = gl->failures = 0;
+    gl->ms_sum = gl->ms_max = 0;
+    gl->stat_start = now;
+  }
+}
+
+GstBuffer *
+gst_cef_gl_import (GstCefGl * gl, const CefAcceleratedPaintInfo & info,
+    gboolean * broken)
+{
+  GstBuffer *buf = NULL;
+  *broken = FALSE;
+
+  g_rec_mutex_lock (&gl->lock);
+  if (!gl->ready || !GST_VIDEO_INFO_WIDTH (&gl->info)) {
+    /* Not negotiated yet; cefsrc asks for a repaint once it is. */
+    g_rec_mutex_unlock (&gl->lock);
+    return NULL;
+  }
+  if (info.plane_count != 1 || info.extra.coded_size.width != GST_VIDEO_INFO_WIDTH (&gl->info)
+      || info.extra.coded_size.height != GST_VIDEO_INFO_HEIGHT (&gl->info)) {
+    /* A resize in flight, or a layout this code does not handle. A resize
+     * settles within a few frames; one that does not is a layout this code
+     * cannot take, and is treated as a failed import. */
+    GST_LOG_OBJECT (gl->element, "Skipping a %dx%d frame with %d planes",
+        info.extra.coded_size.width, info.extra.coded_size.height, info.plane_count);
+    if (++gl->mismatches == 100) {
+      GST_WARNING_OBJECT (gl->element, "Chromium's GPU frames are %dx%d with %d planes, the output %dx%d",
+          info.extra.coded_size.width, info.extra.coded_size.height, info.plane_count,
+          GST_VIDEO_INFO_WIDTH (&gl->info), GST_VIDEO_INFO_HEIGHT (&gl->info));
+      *broken = TRUE;
+    }
+    g_rec_mutex_unlock (&gl->lock);
+    return NULL;
+  }
+
+  gl->mismatches = 0;
+  ImportJob job = { gl, &info, 0, FALSE, FALSE };
+  if (gl->test_break_after && ++gl->imports >= gl->test_break_after) {
+    /* Test hook: behave as if the import had failed for good. */
+    GST_WARNING_OBJECT (gl->element, "GST_CEF_GL_TEST_BREAK_IMPORT: failing import %" G_GUINT64_FORMAT, gl->imports);
+    *broken = TRUE;
+    g_rec_mutex_unlock (&gl->lock);
+    return NULL;
+  }
+  {
+    gint64 t0 = g_get_monotonic_time ();
+    /* Both outputs copy into GL memory first; system memory then reads it
+     * back through GStreamer's download (glReadPixels straight from here
+     * took ~680 ms a 1080p frame on NVIDIA GLES, gldownload's path ~ms). */
+    buf = acquire_locked (gl);
+    if (!buf)
+      goto out;
+    job.dst_tex = buffer_texture (buf);
+    gst_gl_context_thread_add (gl->worker, worker_import, &job);
+    if (job.ok) {
+      mark_written (buf);
+      if (!gl->gl_output) {
+        GstBuffer *sys = NULL;
+        if (!gl->sys_pool || gst_buffer_pool_acquire_buffer (gl->sys_pool, &sys, NULL) != GST_FLOW_OK)
+          sys = gst_buffer_new_allocate (NULL, GST_VIDEO_INFO_SIZE (&gl->info), NULL);
+        GstMapInfo in, out;
+        if (gst_buffer_map (buf, &in, GST_MAP_READ)) {
+          gst_buffer_map (sys, &out, GST_MAP_WRITE);
+          memcpy (out.data, in.data, MIN (in.size, out.size));
+          gst_buffer_unmap (sys, &out);
+          gst_buffer_unmap (buf, &in);
+        } else {
+          GST_WARNING_OBJECT (gl->element, "Could not read Chromium's frame back from the GPU");
+          job.ok = FALSE;
+        }
+        gst_buffer_unref (buf);
+        buf = sys;
+      }
+    }
+    note_frame_locked (gl, (g_get_monotonic_time () - t0) / 1000.0, job.ok);
+  }
+  if (!job.ok)
+    gst_clear_buffer (&buf);
+  if (job.broken)
+    *broken = TRUE;
+  if (job.ok && !gl->announced) {
+    gl->announced = TRUE;
+    GST_INFO_OBJECT (gl->element, "Chromium hands frames over on the GPU (dma-buf, modifier 0x%"
+        G_GINT64_MODIFIER "x), output in %s memory", (guint64) info.modifier, gl->gl_output ? "GL" : "system");
+  }
+
+out:
+  g_rec_mutex_unlock (&gl->lock);
+  return buf;
+}
+
+GstBuffer *
+gst_cef_gl_upload (GstCefGl * gl, const void *bgra, int width, int height)
+{
+  g_rec_mutex_lock (&gl->lock);
+  GstBuffer *buf = NULL;
+  if (gl->gl_output && width == GST_VIDEO_INFO_WIDTH (&gl->info)
+      && height == GST_VIDEO_INFO_HEIGHT (&gl->info)) {
+    buf = acquire_locked (gl);
+    if (buf) {
+      UploadJob job = { gl, buffer_texture (buf), bgra, width, height };
+      gst_gl_context_thread_add (gl->worker, worker_upload, &job);
+      mark_written (buf);
+      if (gl->uploads++ % 300 == 0)
+        GST_INFO_OBJECT (gl->element, "Chromium painted to CPU memory: %" G_GUINT64_FORMAT
+            " frames uploaded into GL memory", gl->uploads);
+    }
+  }
+  g_rec_mutex_unlock (&gl->lock);
+  return buf;
+}
+
+void
+gst_cef_gl_reset (GstCefGl * gl)
+{
+  g_rec_mutex_lock (&gl->lock);
+  release_worker_locked (gl);
+  gst_clear_object (&gl->context);
+  gl->gl_output = FALSE;
+  gst_video_info_init (&gl->info);
+  gl->announced = FALSE;
+  g_rec_mutex_unlock (&gl->lock);
+}
diff --git a/gstcefgl.h b/gstcefgl.h
new file mode 100644
index 0000000..d8d817d
--- /dev/null
+++ b/gstcefgl.h
@@ -0,0 +1,51 @@
+/* GPU output for cefsrc (Linux): frames Chromium hands over as dma-bufs
+ * (OnAcceleratedPaint) are imported into EGL and copied into GL memory, or
+ * read back into system memory when downstream does not take GL memory.
+ * Frames Chromium paints in software (OnPaint) are uploaded into the same GL
+ * memory, so what cefsrc outputs does not depend on how Chromium painted. */
+
+#ifndef __GST_CEF_GL_H__
+#define __GST_CEF_GL_H__
+
+#include <gst/gst.h>
+#include <gst/video/video.h>
+#include <include/cef_render_handler.h>
+
+typedef struct _GstCefGl GstCefGl;
+
+GstCefGl *gst_cef_gl_new (GstElement * element);
+void gst_cef_gl_free (GstCefGl * gl);
+
+/* GstElement::set_context and the CONTEXT query. */
+void gst_cef_gl_set_context (GstCefGl * gl, GstContext * context);
+gboolean gst_cef_gl_handle_query (GstCefGl * gl, GstQuery * query);
+
+/* Called before the browser is created: finds the GL display (the flow's,
+ * through the usual context negotiation), makes a GL context and checks that
+ * it can import Chromium's dma-bufs. Only then is shared_texture_enabled set,
+ * and only then does cefsrc offer GL memory. */
+gboolean gst_cef_gl_prepare (GstCefGl * gl);
+gboolean gst_cef_gl_ready (GstCefGl * gl);
+
+/* Negotiated caps: GL memory or system memory. Sets up the GL buffer pool
+ * in the first case. */
+gboolean gst_cef_gl_decide_allocation (GstCefGl * gl, GstQuery * query);
+gboolean gst_cef_gl_output_is_gl (GstCefGl * gl);
+
+/* A transparent frame in the negotiated memory, shown until the first paint. */
+GstBuffer *gst_cef_gl_blank (GstCefGl * gl);
+
+/* OnAcceleratedPaint: returns the frame in the negotiated memory, or NULL.
+ * Sets *broken when the import failed in a way that will not recover; cefsrc
+ * then recreates the browser without shared textures. */
+GstBuffer *gst_cef_gl_import (GstCefGl * gl,
+    const CefAcceleratedPaintInfo & info, gboolean * broken);
+
+/* OnPaint while GL memory is negotiated: uploads Chromium's BGRA frame. */
+GstBuffer *gst_cef_gl_upload (GstCefGl * gl, const void *bgra, int width,
+    int height);
+
+/* Releases the pool and the contexts (stop). */
+void gst_cef_gl_reset (GstCefGl * gl);
+
+#endif /* __GST_CEF_GL_H__ */
