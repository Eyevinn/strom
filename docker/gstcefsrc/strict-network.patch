+    virtual CefRefPtr<CefPermissionHandler> GetPermissionHandler() override
+    {
+      return this;
+    }
+
+    // CefPermissionHandler Methods:
+    //
+    // Chromium asks before a page reaches this machine or its local network
+    // (Local Network Access). Offscreen, nobody can answer, and CEF's default
+    // for a windowless browser is to ignore the prompt. Answer it outright
+    // instead: a strict browser is refused, any other is allowed.
+    bool OnShowPermissionPrompt(CefRefPtr<CefBrowser> browser,
+        uint64_t prompt_id, const CefString& requesting_origin,
+        uint32_t requested_permissions,
+        CefRefPtr<CefPermissionPromptCallback> callback) override
+    {
+      if (!(requested_permissions & kLocalNetworkPermissions))
+        return false;
+      GST_INFO_OBJECT (src, "%s local network access for %s",
+          src->strict_network ? "Refusing" : "Allowing",
+          requesting_origin.ToString().c_str());
+      callback->Continue(src->strict_network ?
+          CEF_PERMISSION_RESULT_DENY : CEF_PERMISSION_RESULT_ACCEPT);
+      return true;
+    }
